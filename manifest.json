{
"manifest_version": 3,
"name": "KeywordSpy: Competitor Keyword Extractor",
"version": "1.0",
"description": "Passively extract and analyze keywords from App Store and website competitor pages.",
"permissions": [
"activeTab",
"storage",
"scripting",
"tabs"
],
"host_permissions": [
"<all_urls>"
],
"action": {
"default_popup": "popup.html",
"default_icon": {
"16": "icon16.png",
"48": "icon48.png",
"128": "icon128.png"
}
},
"background": {
"service_worker": "background.js"
},
"content_scripts": [
{
"matches": ["<all_urls>"],
"js": ["content.js"]
}
],
"options_page": "dashboard.html"
}
