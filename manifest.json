{
"manifest_version": 3,
"name": "KeywordSpy Pro",
"version": "1.1",
"description": "Premium Competitor Keyword Intelligence.",
"permissions": [
"activeTab",
"storage",
"scripting",
"tabs"
],
"action": {
"default_popup": "popup.html"
},
"background": {
"service_worker": "background.js"
},
"content_scripts": [
{
"matches": ["<all_urls>"],
"js": ["content.js"]
}
],
"options_page": "dashboard.html",
"host_permissions": [
"<all_urls>"
]
}
